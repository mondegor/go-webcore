@startuml
!include <C4/C4_Component>

' title Маршрутизация и сборка обработчиков

Boundary(mrserver_routing, "Маршрутизация и сборка обработчиков") {
  !include components/c4/mrserver/http_router.iuml
  !include components/c4/mrserver/http_controller.iuml
  !include components/c4/mrserver/http_handler.iuml
  !include components/c4/router/router_adapter.iuml
  !include components/c4/router/url_path_param.iuml
  !include components/c4/httpserver/server_adapter.iuml
  !include components/c4/middleware/handler_adapter.iuml
  !include components/c4/initing/http_module.iuml
  !include components/c4/initing/create_http_controllers.iuml
  !include components/c4/initing/prepare_handler.iuml
}

!include components/c4/mrserver/error_response_sender.iuml
!include components/c4/ext/chi.iuml

Rel(http_controller, http_handler, "Возвращает список обработчиков")
Rel(router_adapter, http_router, "Реализует интерфейс")
Rel(router_adapter, http_controller, "Регистрирует обработчики контроллеров (Register)")
Rel(router_adapter, handler_adapter, "Оборачивает каждый HttpHandlerFunc в http.HandlerFunc")
Rel(router_adapter, chi, "Делегирует маршрутизацию; VarRestOfURL преобразуется в формат маршрутизатора")
Rel(url_path_param, chi, "Читает параметры пути из контекста маршрутизатора")
Rel(handler_adapter, error_response_sender, "Передаёт ошибку, возвращённую обработчиком")
Rel(server_adapter, router_adapter, "Передаёт входящие запросы (ServeHTTP)")
Rel(create_http_controllers, http_module, "Создаёт контроллеры модулей, наследуя разрешение модуля")
Rel(create_http_controllers, prepare_handler, "Применяет операции к каждому обработчику (PrepareHttpController)")
Rel(prepare_handler, http_handler, "Устанавливает Permission, префикс группы и обёртку проверки доступа")

@enduml
